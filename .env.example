# ============================================
# 网文拆解系统 — 环境配置
# 详细说明见 CONFIG.md
# ============================================

# 提供商: anthropic 或 deepseek
NOVEL_DECOMP_PROVIDER=anthropic

# API Key（Anthropic 和 DeepSeek 共用此字段名）
ANTHROPIC_API_KEY=sk-ant-api03-your-key-here

# API 端点
# Anthropic: 不设（默认 https://api.anthropic.com）
# DeepSeek: 填 https://api.deepseek.com（注意：不是 /anthropic 后缀）
# ANTHROPIC_BASE_URL=https://api.deepseek.com

# 主分析模型
# Anthropic: claude-sonnet-4-6-20250514
# DeepSeek:  deepseek-v4-pro 或 deepseek-v4-flash
NOVEL_DECOMP_MODEL=claude-sonnet-4-6-20250514

# 廉价模型（可选，用于轻量任务）
NOVEL_DECOMP_CHEAP_MODEL=claude-haiku-4-5-20251001
